@model PTPI.Models.ViewModels.PersonListViewModel
@{
    ViewData["Title"] = "Persons";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Persons</h2>
    <a asp-action="Create" class="btn btn-primary">+ Add Person</a>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-8">
                <label class="form-label text-muted small">Search by ID Number, Surname or Account Number</label>
                <input type="text" name="searchTerm" value="@Model.SearchTerm"
                       class="form-control" placeholder="Enter search term..." />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-secondary w-100">Search</button>
            </div>
            <div class="col-md-2">
                <a asp-action="Index" class="btn btn-outline-secondary w-100">Clear</a>
            </div>
        </form>
    </div>
</div>

@if (!Model.Persons.Any())
{
    <div class="alert alert-info">
        @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
        {
            <span>No persons found matching "<strong>@Model.SearchTerm</strong>".</span>
        }
        else
        {
            <span>No persons have been added yet.</span>
        }
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-2">
        <small class="text-muted">
            Showing @(((Model.CurrentPage - 1) * PTPI.Models.ViewModels.PersonListViewModel.PageSize) + 1)–@(Math.Min(Model.CurrentPage * PTPI.Models.ViewModels.PersonListViewModel.PageSize, Model.TotalCount)) of @Model.TotalCount person(s)
        </small>
    </div>

    <div class="table-responsive">
        <table class="table table-hover table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Surname</th>
                    <th>ID Number</th>
                    <th class="text-center">Accounts</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var person in Model.Persons)
                {
                    <tr>
                        <td>@(person.Name ?? "—")</td>
                        <td>@(person.Surname ?? "—")</td>
                        <td><code>@person.IdNumber</code></td>
                        <td class="text-center">
                            <span class="badge bg-secondary">@person.Accounts.Count</span>
                        </td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@person.Code"
                               class="btn btn-sm btn-outline-primary me-1">Edit</a>
                            <a asp-action="Delete" asp-route-id="@person.Code"
                               class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Persons pagination">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-searchTerm="@Model.SearchTerm"
                       asp-route-page="@(Model.CurrentPage - 1)">Previous</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-page="@i">@i</a>
                    </li>
                }
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-searchTerm="@Model.SearchTerm"
                       asp-route-page="@(Model.CurrentPage + 1)">Next</a>
                </li>
            </ul>
        </nav>
    }
}

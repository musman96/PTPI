@model PTPI.Models.Account
@{
    ViewData["Title"] = "Add Account";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Persons" asp-action="Index">Persons</a></li>
        <li class="breadcrumb-item">
            <a asp-controller="Persons" asp-action="Edit" asp-route-id="@Model.PersonCode">Person Details</a>
        </li>
        <li class="breadcrumb-item active">New Account</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">New Account</h5>
            </div>
            <div class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="PersonCode" />

                    <div class="mb-3">
                        <label asp-for="AccountNumber" class="form-label"></label>
                        <input asp-for="AccountNumber" class="form-control" />
                        <span asp-validation-for="AccountNumber" class="text-danger small"></span>
                    </div>

                    <div class="alert alert-info small mb-3">
                        <strong>Note:</strong> Outstanding balance starts at R 0.00 and updates automatically
                        when transactions are added. Transactions can be added after the account is saved.
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Save Account</button>
                        <a asp-controller="Persons" asp-action="Edit" asp-route-id="@Model.PersonCode"
                           class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

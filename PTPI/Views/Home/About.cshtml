@{
    ViewData["Title"] = "About";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h2 class="mb-4">About This Application</h2>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
                <h5 class="card-title text-primary">PTP Integrated — Account Management System</h5>
                <p class="card-text">
                    This application was built as part of the PTP Integrated Developer Technical Competency Assessment.
                    It provides a full MVC .NET Core solution for managing persons, their accounts, and transaction histories.
                </p>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
                <h5 class="card-title text-primary">Features</h5>
                <ul class="mb-0">
                    <li>Person management with unique ID number enforcement</li>
                    <li>Account management with auto-calculated outstanding balances</li>
                    <li>Transaction capture with debit/credit support</li>
                    <li>Search by ID number, surname, or account number</li>
                    <li>Paginated person list (10 per page)</li>
                    <li>Account close and re-open functionality</li>
                    <li>Authentication — login required to manage records</li>
                </ul>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h5 class="card-title text-primary">Technology Stack</h5>
                <ul class="mb-0">
                    <li>ASP.NET Core 8 MVC</li>
                    <li>Entity Framework Core 8 with SQL Server</li>
                    <li>ASP.NET Core Identity</li>
                    <li>Bootstrap 5</li>
                    <li>SOLID principles (interface-based service layer)</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@model PTPI.Models.Transaction
@{
    ViewData["Title"] = "Edit Transaction";
    var today = DateTime.Today.ToString("yyyy-MM-dd");
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Persons" asp-action="Index">Persons</a></li>
        <li class="breadcrumb-item">
            <a asp-controller="Accounts" asp-action="Edit" asp-route-id="@Model.AccountCode">Account</a>
        </li>
        <li class="breadcrumb-item active">Edit Transaction</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Edit Transaction</h5>
            </div>
            <div class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <form asp-action="Edit" asp-route-id="@Model.Code" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Code" />
                    <input type="hidden" asp-for="AccountCode" />

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <input asp-for="Description" class="form-control" maxlength="100" />
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Amount" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text">R</span>
                            <input asp-for="Amount" type="number" step="0.01" class="form-control" />
                        </div>
                        <small class="text-muted">Negative = debit, positive = credit. Cannot be zero.</small>
                        <span asp-validation-for="Amount" class="text-danger small d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="TransactionDate" class="form-label"></label>
                        <input asp-for="TransactionDate" type="date" class="form-control" max="@today" />
                        <small class="text-muted">Transaction date cannot be in the future.</small>
                        <span asp-validation-for="TransactionDate" class="text-danger small d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="CaptureDate" class="form-label"></label>
                        <input type="text" value="@Model.CaptureDate.ToString("dd MMM yyyy HH:mm")"
                               class="form-control bg-light" readonly />
                        <small class="text-muted">Capture date is set automatically and cannot be changed.</small>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                        <a asp-controller="Accounts" asp-action="Edit" asp-route-id="@Model.AccountCode"
                           class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
